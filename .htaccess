# KUTT SUKA MAKMUR - Apache root .htaccess (cPanel)
# Mengarahkan semua request HTTP ke public/index.php (front controller).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jika aplikasi berada di subfolder (mis. /kutt), sesuaikan:
  # RewriteBase /kutt/

  # File & folder nyata dilayani langsung
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Semua request lain masuk ke front controller di public/
  RewriteRule ^ public/index.php [L]
</IfModule>

# Lindungi folder sensitif
<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

Options -Indexes
