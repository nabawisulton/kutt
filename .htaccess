# KUTT SUKA MAKMUR - Apache root .htaccess (cPanel)
# Mengarahkan semua request HTTP ke public/index.php (front controller).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jika aplikasi berada di subfolder (mis. /kutt), sesuaikan:
  # RewriteBase /kutt/

  # File & folder nyata dilayani langsung
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Semua request lain masuk ke front controller di public/
  RewriteRule ^ public/index.php [L]
</IfModule>

# ---- LINDUNGI FILE SENSITIF (tidak boleh dilayani Apache) -------------------
# .env / .env.local berisi kredensial database.
<FilesMatch "^(\.env|\.env\..*|\.git.*)$">
  Require all denied
</FilesMatch>

# Source code & alat internal tidak perlu diakses via HTTP.
<FilesMatch "^(install\.php|export_schema\.php)$">
  Require all denied
</FilesMatch>

# Folder source/database/tests diblokir seluruhnya (bukan area web).
RedirectMatch 403 ^/?(src|database|tests|storage|config)/

# ---- SECURITY HEADERS --------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

Options -Indexes
